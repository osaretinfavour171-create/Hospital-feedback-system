# Copy this file to `.env` and fill in your free Groq API key to enable
# live AI extraction (llama-3.3-70b-versatile) and audio transcription
# (whisper-large-v3). Without a key the demo runs in OFFLINE mode with a
# built-in rule-based extractor — everything works except voice notes.
#
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3
# SALT_SECRET=demo_salt_123
# SQLITE_DB_PATH=hospital_demo.db
